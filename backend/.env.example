# --- Database (PostgreSQL 15+ with the pgvector extension) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meeting_assistant

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Local Development Auth Bypass ---
# WARNING: NEVER enable this in production or public access environments!
# When true, bypasses login/registration and uses a fixed local development user/workspace.
DEV_AUTH_BYPASS=false
ENVIRONMENT=development

# --- OpenAI (used by the backend ONLY; never shipped to desktop/web clients) ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EMBEDDING_DIMENSIONS=1536

# --- App ---
CORS_ORIGINS=http://localhost:5173
WEB_APP_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# --- RAG ---
RAG_TOP_K=5
RAG_RECENT_TRANSCRIPT_SECONDS=180
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
